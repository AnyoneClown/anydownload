{
  "manifest_version": 3,
  "name": "Page Image Downloader",
  "version": "1.6.1",
  "description": "Find full-size page images with smart filters, live capture, ZIP downloads, and a Firefox Sidebar that follows tabs.",
  "permissions": [
    "activeTab",
    "downloads",
    "menus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Download page images",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/image-downloader.svg",
      "32": "icons/image-downloader.svg"
    }
  },
  "sidebar_action": {
    "default_title": "AnyDownload images",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/image-downloader.svg",
      "32": "icons/image-downloader.svg"
    },
    "open_at_install": false
  },
  "icons": {
    "48": "icons/image-downloader.svg",
    "96": "icons/image-downloader.svg"
  },
  "background": {
    "scripts": [
      "shared/core.js",
      "shared/collector.js",
      "shared/archive.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "page-image-downloader@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' http: https: data: blob:; style-src 'self'; connect-src http: https: data: blob:"
  }
}
