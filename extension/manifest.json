{
  "manifest_version": 3,
  "name": "AnyDownload — Page Media Downloader",
  "version": "1.9.0",
  "description": "Download page media, Instagram collections, and basic progressive YouTube videos with safe bulk queues.",
  "permissions": [
    "activeTab",
    "downloads",
    "menus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Download page media",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/image-downloader.svg",
      "32": "icons/image-downloader.svg"
    }
  },
  "sidebar_action": {
    "default_title": "AnyDownload media",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/image-downloader.svg",
      "32": "icons/image-downloader.svg"
    },
    "open_at_install": false
  },
  "icons": {
    "48": "icons/image-downloader.svg",
    "96": "icons/image-downloader.svg"
  },
  "background": {
    "scripts": [
      "shared/core.js",
      "shared/collector.js",
      "shared/fapfolder.js",
      "shared/instagram.js",
      "shared/youtube.js",
      "shared/archive.js",
      "shared/templates.js",
      "shared/download-queue.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "page-image-downloader@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; style-src 'self'; connect-src http: https: data: blob:"
  }
}
